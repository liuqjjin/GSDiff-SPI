{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-evidence-contract-v1.schema.json",
  "title": "GSDiff-SPI phase evidence contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "phase_sha256",
    "expected_record_count",
    "statistics_contract_sha256",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": "phase-evidence-contract-v1"
    },
    "phase_id": {
      "$ref": "#/$defs/id"
    },
    "phase_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "statistics_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "identity_sha256",
          "scientific_contract_id",
          "scientific_contract_sha256"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/logical_run_key"
          },
          "identity_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "scientific_contract_id": {
            "$ref": "#/$defs/id"
          },
          "scientific_contract_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logical_run_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "acquisition_config_id",
        "method_config_id",
        "method_id",
        "target_id",
        "motion_id",
        "seed"
      ],
      "properties": {
        "phase_id": {
          "$ref": "#/$defs/id"
        },
        "acquisition_config_id": {
          "$ref": "#/$defs/id"
        },
        "method_config_id": {
          "$ref": "#/$defs/id"
        },
        "method_id": {
          "$ref": "#/$defs/id"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "motion_id": {
          "$ref": "#/$defs/id"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
